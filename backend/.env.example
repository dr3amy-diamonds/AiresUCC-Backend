# ============================================================================
# ARCHIVO DE CONFIGURACIÓN - EJEMPLO
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a ".env" en la carpeta backend/
# 2. Reemplazar los valores EXAMPLE con tus credenciales reales
# 3. NUNCA commitear el archivo .env con credenciales reales
# ============================================================================

# ============================================================================
# 🗄️ CONFIGURACIÓN DE BASE DE DATOS
# ============================================================================
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql://aires_user:your_secure_password@localhost:5432/aires_ucc

# ============================================================================
# 🔐 SEGURIDAD Y AUTENTICACIÓN
# ============================================================================
# Clave secreta para firmar JWT tokens
# IMPORTANTE: Cambiar a una clave FUERTE en producción
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-12345

# Algoritmo de firma para JWT
ALGORITHM=HS256

# Tiempo de expiración de tokens en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# 🚀 CONFIGURACIÓN DE APLICACIÓN
# ============================================================================
# Modo de depuración (False en producción)
DEBUG=False

# Nivel de logs (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# 📝 NOTAS ADICIONALES
# ============================================================================
# - En desarrollo local, puedes usar valores de prueba
# - En producción, TODAS las variables deben estar bien aseguradas
# - Los valores reales NUNCA deben estar en control de versiones
# - Usar secretos de plataforma (Heroku Config Vars, Railway Env, etc.)

