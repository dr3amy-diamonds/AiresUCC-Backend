# ==========================================
# GITIGNORE - AiresFlow Backend API
# Proyecto: Sistema de Gestión de Climatización UCC
# ==========================================
# Este archivo especifica qué archivos y carpetas NO deben subirse al
# repositorio remoto (GitHub, GitLab, etc.)
# ==========================================

# ==========================================
# 🔐 ARCHIVOS SENSIBLES (NUNCA SUBIR)
# ==========================================

# Variables de entorno con secrets (CRÍTICO: NUNCA COMMITEAR)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.dev
.env.prod
backend/.env
backend/.env.local

# Claves y certificados SSL/TLS
