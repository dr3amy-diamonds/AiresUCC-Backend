# ==========================================
# ⚠️ EXCEPCIONES - ARCHIVOS QUE SÍ SUBIR
# ==========================================

# Asegurar que estos archivos SE suban
!.gitignore
!.env.example
!.env.template
!.gitkeep
!.github/
!.gitattributes

# Archivos del proyecto que deben ir
!database/backup.sql
!alembic/versions/
!scripts/
!requirements.txt
!setup.py
!README.md

# ==========================================
# 📝 REFERENCIAS
# ==========================================

# Archivos que NUNCA deben commitear:
# - .env (credenciales sensibles)
# - __pycache__/ (cache Python)
# - venv/ (entorno virtual)
# - *.pyc (compilados Python)
# - .idea/ (configuración PyCharm)
# - .vscode/ (configuración VSCode)
# - *.log (archivos de log)
# - *.egg-info/ (metadata de paquetes)
#
# Para forzar agregar un archivo ignorado:
# git add -f archivo.txt

